# Secrets referenced from config/gateway.config.json via ${VAR} placeholders.
# Keep this file out of version control (.gitignore covers .env).
# The gateway does not read .env itself; export these before starting it, e.g.
#   PowerShell:  $env:PAPERLESS_API_TOKEN = "..."
#   bash:        set -a; . ./.env; set +a

# Paperless (used by the existing Paperless MCP server, passed through to it)
PAPERLESS_URL=https://paperless.example.org
PAPERLESS_API_TOKEN=

# SMTP for the private_mail target
SMTP_USER=
SMTP_PASSWORD=

# Telegram for the private_telegram target
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret Hermes must send as `Authorization: Bearer ...` when the
# MCP interface runs over HTTP. Required for transport "http" or "both".
HERMES_GATEWAY_TOKEN=
