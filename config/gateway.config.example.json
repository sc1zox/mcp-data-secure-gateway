{
  "dataDir": "./data",
  "logLevel": "info",

  "sources": [
    {
      "id": "paperless",
      "kind": "paperless-mcp",
      "label": "Paperless",
      "enabled": true,
      "transport": {
        "kind": "stdio",
        "command": "npx",
        "args": ["-y", "@kjanat/paperless-mcp"],
        "env": {
          "PAPERLESS_URL": "${PAPERLESS_URL}",
          "PAPERLESS_API_KEY": "${PAPERLESS_API_TOKEN}"
        }
      },
      "tools": {
        "search": "search_documents",
        "get": "get_document",
        "download": "download_document"
      },
      "webBaseUrl": "${PAPERLESS_URL}",
      "maxCandidates": 8,
      "excerptChars": 2500,
      "summaryChars": 20000
    }
  ],

  "localModel": {
    "baseUrl": "http://127.0.0.1:11434",
    "model": "qwen3.5:9b",
    "idleTimeoutMs": 300000,
    "temperature": 0,
    "numCtx": 16384
  },

  "targets": [
    {
      "id": "private_mail",
      "kind": "smtp",
      "enabled": true,
      "label": "Private E-Mail",
      "purpose": "Versand an das eigene private E-Mail-Postfach.",
      "smtp": {
        "host": "smtp.example.org",
        "port": 587,
        "secure": false,
        "user": "${SMTP_USER}",
        "password": "${SMTP_PASSWORD}"
      },
      "from": "gateway@example.org",
      "to": "ich@example.org",
      "maxAttachments": 10,
      "maxAttachmentBytes": 14542294,
      "optimization": { "mode": "balanced", "pdf": true, "jpeg": true }
    },
    {
      "id": "job_application_mail",
      "kind": "smtp",
      "enabled": true,
      "label": "E-Mail (Empfänger je Aktion)",
      "purpose": "Versand an eine vom Nutzer je Aktion bestätigte Empfängeradresse.",
      "smtp": {
        "host": "smtp.example.org",
        "port": 587,
        "secure": false,
        "user": "${SMTP_USER}",
        "password": "${SMTP_PASSWORD}"
      },
      "from": "gateway@example.org",
      "allowDynamicRecipient": true,
      "maxAttachments": 10,
      "maxAttachmentBytes": 14542294,
      "optimization": { "mode": "compact", "pdf": true, "jpeg": true }
    },
    {
      "id": "private_telegram",
      "kind": "telegram",
      "enabled": true,
      "label": "Privater Telegram-Chat",
      "purpose": "Versand in den eigenen privaten Telegram-Chat.",
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "chatId": "${TELEGRAM_CHAT_ID}",
      "maxAttachments": 10,
      "maxAttachmentBytes": 52428800,
      "optimization": { "mode": "disabled", "pdf": true, "jpeg": true }
    }
  ],

  "approval": {
    "host": "127.0.0.1",
    "port": 8787,
    "uiToken": "${APPROVAL_UI_TOKEN}",
    "telegramSettingsKey": "${TELEGRAM_APPROVAL_SETTINGS_KEY}",
    "actionTtlSeconds": 1800,
    "referenceTtlSeconds": 3600,
    "selectionTtlSeconds": 1800
  },

  "attachmentOptimization": {
    "enabled": true,
    "limits": {
      "maxSingleInputBytes": 52428800,
      "maxTotalInputBytes": 104857600,
      "maxWorkingBytes": 314572800,
      "timeBudgetMs": 30000
    },
    "execution": {
      "maxConcurrentPdfJobs": 1,
      "maxConcurrentJpegJobs": 2
    },
    "pdf": {
      "enabled": true,
      "qpdfStructuralOptimization": true,
      "rejectOnWarnings": false,
      "profiles": ["balanced", "compact"],
      "qpdfCommand": "qpdf",
      "ghostscriptCommand": "gs"
    },
    "jpeg": {
      "enabled": true,
      "maxPixels": 80000000,
      "maxChannels": 4,
      "profiles": ["balanced", "compact"]
    }
  },

  "hermesInterface": {
    "transport": "http",
    "http": {
      "host": "0.0.0.0",
      "port": 8788,
      "path": "/mcp",
      "bearerToken": "${HERMES_GATEWAY_TOKEN}",
      "allowedHosts": ["llm-gateway.sc1zox.dev"]
    }
  }
}
