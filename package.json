{
  "name": "local-trust-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Local Trust Gateway: kontrollierter Zugriff eines Cloud-Agenten (Hermes) auf private Dienste, mit lokaler semantischer Bewertung und lokaler Freigabe.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "local-trust-gateway": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
