node_modules/
dist/
*.log

# Local state: contains the mapping between opaque references and real
# resources, plus the audit trail. Must never leave the machine.
data/
config/gateway.config.json
.env

# Angular build caches. The UI keeps its own dependency tree under ui/, so that
# node_modules is covered by the pattern above rather than by a second rule.
ui/.angular/

# Local tooling state
.claude/settings.local.json
